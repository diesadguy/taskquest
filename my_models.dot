digraph model_graph {
  // Dotfile by Django-Extensions graph_models
  // Created: 2026-06-17 14:21
  // Cli Options: accounts projects tasks gamification --dot -o my_models.dot

  fontname = "Roboto"
  fontsize = 8
  splines  = true
  rankdir = "TB"
  

  node [
    fontname = "Roboto"
    fontsize = 8
